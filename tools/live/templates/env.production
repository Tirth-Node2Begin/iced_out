###############################################################################
#                                                                             #
#   ★★★  THIS IS THE FILE YOU EDIT.  ★★★                                      #
#                                                                             #
#   Put the live MySQL credentials in the DATABASE block below and nothing     #
#   else has to change. It is the only file in the whole deployment that       #
#   holds a secret, and it lives OUTSIDE the document root, so no URL can      #
#   ever read it.                                                             #
#                                                                             #
#   On the server it is:   /home/<your-cpanel-user>/iced-out-api/.env          #
#                                                                             #
#   After editing, nothing needs restarting — PHP reads it on every request.   #
#                                                                             #
###############################################################################

APP_ENV=production
# false in production, always. `true` prints stack traces into API responses.
APP_DEBUG=false
# The site's own address. This is what marks session cookies Secure and what
# the CSRF origin check trusts, so the scheme matters: https, no trailing slash.
APP_URL=https://{{DOMAIN}}
# Flip to true to take the API down for maintenance without deleting anything.
APP_MAINTENANCE=false


# ─────────────────────────────────────────────────────────────────────────────
#  DATABASE   ←── the four lines to fill in
# ─────────────────────────────────────────────────────────────────────────────
#
#  In cPanel → MySQL® Databases:
#    1. create a database             → it is named  cpaneluser_icedout
#    2. create a user                 → it is named  cpaneluser_iced
#    3. "Add User To Database"        → tick ALL PRIVILEGES
#
#  cPanel prefixes both names with your account name. Copy what it shows you,
#  prefix included — that full string is what goes below.
#
#  DB_HOST stays localhost on cPanel. Only change it if your host gave you a
#  separate database server address.
#
DB_HOST=localhost
DB_PORT=3306
DB_NAME=REPLACE_WITH_YOUR_DATABASE_NAME
DB_USER=REPLACE_WITH_YOUR_DATABASE_USER
DB_PASS=REPLACE_WITH_YOUR_DATABASE_PASSWORD


# --- One-time installer gate ---------------------------------------------
# The token public_html/setup.php demands before it will create the schema.
# Blank switches the installer off entirely. Blank it again — and delete
# setup.php — the moment the site is up.
SETUP_TOKEN={{SETUP_TOKEN}}


# --- Sessions -------------------------------------------------------------
SESSION_COOKIE_CUSTOMER=io_csess
SESSION_COOKIE_STAFF=io_ssess
# 64 hex characters, minted for this deployment by the build. Session and
# tracking tokens are HMAC'd with it: change it and every signed-in shopper is
# signed out, so set it once and leave it alone. Never reuse the dev value.
SESSION_SECRET={{SESSION_SECRET}}
CUSTOMER_SESSION_TTL=2592000
STAFF_SESSION_IDLE_TTL=900


# --- Redis (optional) ------------------------------------------------------
# Shared hosting rarely has one. Blank is fine and supported: the cache, rate
# limiter and locks fall back to files under storage/cache, and the queue falls
# back to the job_queue table.
REDIS_URL=


# --- Payments (Razorpay) ---------------------------------------------------
# KEY_ID is public — the storefront reads it from GET /api/v1/config/storefront
# at runtime, so setting it here needs NO frontend rebuild.
# KEY_SECRET is not public and never reaches a response body.
# Both blank ⇒ checkout says card payments are not configured, rather than
# opening a gateway that cannot charge. COD keeps working either way.
#
# Use the LIVE keys (rzp_live_…) here, not the test ones.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TIMEOUT=20


# --- Media -----------------------------------------------------------------
# Relative to iced-out-api/. Must stay writable by PHP (755 is usually enough
# on cPanel; 775 if the web server runs as a different user).
MEDIA_DRIVER=local
MEDIA_ROOT=storage/media
S3_BUCKET=
S3_REGION=
S3_KEY=
S3_SECRET=
S3_ENDPOINT=


# --- Background removal (remove.bg) — the home page hero's cutouts ----------
# Blank ⇒ uploads still save and every slide reports "Skipped" with the reason.
REMOVE_BG_API_KEY=
REMOVE_BG_ENDPOINT=https://api.remove.bg/v1.0/removebg
REMOVE_BG_SIZE=auto
REMOVE_BG_TIMEOUT=45


# --- Mail (SMTP) -----------------------------------------------------------
# ⚠ `log` writes the password-reset code into storage/logs and sends nothing.
#   That is the development default and it is NOT safe here: a code in a log
#   file is a code anyone who can read the log has. Set this to `smtp` and fill
#   in a real mailbox before you let anyone use "forgot password".
#
# cPanel: create an address in Email Accounts, then use
#   SMTP_HOST=mail.{{DOMAIN}}   SMTP_PORT=465   SMTP_ENCRYPTION=ssl
#   SMTP_USER=<the full address>  SMTP_PASS=<its password>
# Gmail: smtp.gmail.com / 587 / an App Password, not the account password.
MAIL_DRIVER=log
MAIL_FROM=no-reply@{{DOMAIN}}
MAIL_FROM_NAME=Iced_out
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=
SMTP_TIMEOUT=15


# --- CORS ------------------------------------------------------------------
# Deliberately empty. The site and the API are one origin here — Apache serves
# the export at / and PHP at /api/v1 — so the browser never makes a cross-site
# call and no preflight fires. Adding an origin here only widens the CSRF
# origin check; leave it blank unless you genuinely split the two apart.
CORS_ALLOWED_ORIGINS=


# --- External delivery-tracking API — placeholders, leave blank -------------
# Blank base URL ⇒ the placeholder provider is bound and no courier data is
# ever invented. Fill in when you have a courier account.
TRACKING_API_BASE_URL=
TRACKING_API_KEY=
TRACKING_API_WEBHOOK_SECRET=
