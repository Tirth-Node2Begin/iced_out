# ─────────────────────────────────────────────────────────────────────────────
# Iced_out API — the /api/v1 web root.
#
# GENERATED by tools/live/build-live.mjs. Edit the template, not this copy:
# tools/live/templates/htaccess-api.
#
# The PHP that runs is here; everything it reads — .env, config, src, storage —
# lives OUTSIDE the document root and is reached through _backend.php.
# ─────────────────────────────────────────────────────────────────────────────

Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # A file that exists is served as it is. (bootstrap.php and _backend.php are
    # refused further down — that is an access rule, not a routing one.)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # /auth/login → auth/login.php, the file that names that route.
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L]

    # EVERYTHING else goes to the front controller, which matches the same route
    # table. No `!-d` guard, and that omission is the point.
    #
    # A collection with a parameterised child is a DIRECTORY here: the route
    # /catalog/products has catalog/products/ beside it holding show.php. Guarded
    # with `!-d`, neither rule above could fire and the request fell out of this
    # file entirely — landing on mod_dir, then on the site's HTML 404 page.
    # /catalog/products, /me/addresses, /me/orders and /me/sessions all answered
    # text/html 404 instead of JSON, and on the console side twenty-nine routes
    # did. It never showed in development because `php -S` uses dev-server.php,
    # which has always sent anything-not-a-file to the front controller — exactly
    # what this rule now does, so the two agree.
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Required by the endpoint files, never requested directly.
<FilesMatch "^(bootstrap|_backend)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
