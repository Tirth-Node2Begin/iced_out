# ─────────────────────────────────────────────────────────────────────────────
# LAYER 2 of 3.  Nothing in this folder may be served over HTTP. Ever.
#
# GENERATED by tools/live/build-live.mjs — edit
# tools/live/templates/htaccess-private.
#
# In the SINGLE-FOLDER layout this directory sits inside the document root, so
# there IS a URL that maps to it and this file is load-bearing. `.env` below
# holds the live database password; storage/logs holds password-reset codes when
# MAIL_DRIVER=log; storage/media holds every upload.
#
# In the split layout the folder lives above the document root and no URL
# reaches it at all — there this file is a seatbelt for the day somebody moves
# it. If you ever see a page from in here, the folder is in the wrong place.
#
# PHP inside is unaffected: index.php and bootstrap.php reach these files
# through the filesystem (require), which no web-server rule touches. Only
# requests from a browser are refused.
# ─────────────────────────────────────────────────────────────────────────────

# Apache 2.4 / LiteSpeed.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2.
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# And again through mod_rewrite, for a host where the authz modules above are
# compiled out or overridden higher up. Three ways of saying no, because being
# wrong here costs the database password.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^ - [F,L]
</IfModule>

# Belt: never hand these to an interpreter or a download, whatever else happens.
<FilesMatch "\.(env|sql|log|md|json|lock|ini|ya?ml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Braces: stop mod_php running anything found in here, so even a request that
# somehow got past all three layers above gets bytes rather than execution.
#
# Guarded on the MODULE NAME (php_module), not the source file (mod_php.c).
# Apache's own docs use the source-file form, and for PHP 8 that form is simply
# never true — `<IfModule mod_php.c>` around this is a comment, not a rule. The
# older names are kept for hosts still on PHP 5/7.
#
# Guarded at all because under PHP-FPM and LiteSpeed `php_flag` is an unknown
# directive, and an unguarded one is a 500 on every request into this folder.
<IfModule php_module>
    php_flag engine off
</IfModule>
<IfModule php7_module>
    php_flag engine off
</IfModule>
<IfModule php5_module>
    php_flag engine off
</IfModule>

Options -Indexes -ExecCGI
