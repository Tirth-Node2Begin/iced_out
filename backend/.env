# Iced_out backend â€” copy to .env and fill in.
# Every key here is read through Iced\Support\Env; nothing else reads getenv() directly.

APP_ENV=dev
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_MAINTENANCE=false

# --- Database (MySQL 8.x in production; MariaDB 10.4+ works for local XAMPP dev) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=iced_out
DB_USER=root
DB_PASS=

# --- Redis (optional; absent => file cache + job_queue table fallback) ---
REDIS_URL=

# --- Sessions ---
SESSION_COOKIE_CUSTOMER=io_csess
SESSION_COOKIE_STAFF=io_ssess
# 64 hex chars â€” generate with: php bin/console.php key:generate
SESSION_SECRET=3f14caf184ab067fe4f07450ee661dc3528c988d0b82e242b09d5eae8d1d5892
CUSTOMER_SESSION_TTL=2592000
STAFF_SESSION_IDLE_TTL=900

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=rzp_test_SVvlknfTZT9HHN
RAZORPAY_KEY_SECRET=L15ZNOMu9efIXr6H4274g0Fz
RAZORPAY_WEBHOOK_SECRET=

# --- Media ---
MEDIA_DRIVER=local
MEDIA_ROOT=storage/media
S3_BUCKET=
S3_REGION=
S3_KEY=
S3_SECRET=
S3_ENDPOINT=

# --- Background removal (remove.bg) — the home page hero's ghost cutouts ---
# Get a key at https://www.remove.bg/dashboard#api-key. Blank => uploads still
# save, cutouts report "Skipped", and the console shows why.
REMOVE_BG_API_KEY=sDbuEKV4SFudNvMovxwub5QK
REMOVE_BG_ENDPOINT=https://api.remove.bg/v1.0/removebg
# auto = billed by output size; preview = the free tier's 0.25MP
REMOVE_BG_SIZE=auto
REMOVE_BG_TIMEOUT=45

# --- Mail (SMTP) ---
# Drives the forgotten-password codes on both the shop and the console.
#   log  — writes the whole message, code included, to storage/logs and sends
#          nothing. The development default: the flow is exercisable end to end
#          with no credentials, and `tail -f storage/logs/app-*.log` is the inbox.
#          NEVER production — a code in a log file is a code anyone with the log has.
#   smtp — a real server. SMTP_HOST blank falls back to `log` and logs why.
MAIL_DRIVER=log
MAIL_FROM=no-reply@iced-out.example
MAIL_FROM_NAME=Iced_out
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# tls = STARTTLS on 587 (the usual), ssl = implicit TLS on 465,
# none = a local relay (MailHog/Mailpit) — credentials are refused over `none`.
# Left blank it is inferred from the port: 465 => ssl, anything else => tls.
SMTP_ENCRYPTION=
SMTP_TIMEOUT=15
#
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<the address>,
# and SMTP_PASS=<a 16-character App Password from
# https://myaccount.google.com/apppasswords>, which needs 2-Step Verification on
# the account. The normal account password is refused by Google and always has been.
# MAIL_FROM should be that same address, or the message is rejected or filed as spam.

# --- CORS (split-origin dev only; single-origin prod needs none) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- External delivery-tracking API â€” PLACEHOLDERS, leave blank until provided (spec Â§9.8) ---
TRACKING_API_BASE_URL=
TRACKING_API_KEY=
TRACKING_API_WEBHOOK_SECRET=
