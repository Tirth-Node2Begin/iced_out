# Iced_out backend — copy to .env and fill in.
# Every key here is read through Iced\Support\Env; nothing else reads getenv() directly.

APP_ENV=dev
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_MAINTENANCE=false

# --- Database (MySQL 8.x in production; MariaDB 10.4+ works for local XAMPP dev) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=iced_out
DB_USER=root
DB_PASS=

# --- Redis (optional; absent => file cache + job_queue table fallback) ---
REDIS_URL=

# --- Sessions ---
SESSION_COOKIE_CUSTOMER=io_csess
SESSION_COOKIE_STAFF=io_ssess
# 64 hex chars — generate with: php bin/console.php key:generate
SESSION_SECRET=
CUSTOMER_SESSION_TTL=2592000
STAFF_SESSION_IDLE_TTL=900

# --- Payments (Razorpay) ---
# KEY_ID is public — it is served to the storefront by GET /config/storefront.
# KEY_SECRET is not, and is read only by RazorpayGateway: it signs the order
# creation and verifies razorpay_signature, and never reaches a response body.
# Both blank => the checkout says card payments are not configured rather than
# opening a gateway that cannot charge.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# A DIFFERENT secret from KEY_SECRET, issued by Razorpay when you register the
# webhook. Point the dashboard at POST /api/v1/webhooks/razorpay and subscribe to
# payment.captured, payment.authorized, payment.failed and order.paid.
#
# Blank means the webhook endpoint refuses every delivery — which is the safe
# answer, because accepting unsigned events would make that URL a way for anyone
# to mark payments verified. It also means the gateway's own account of what
# happened never reaches this server, so a shopper whose browser never got back
# to us has a payment nothing here knows about.
RAZORPAY_WEBHOOK_SECRET=
# Seconds to wait on api.razorpay.com. A shopper is watching a spinner behind it.
RAZORPAY_TIMEOUT=20

# Whether the SERVER decides that a payment happened.
#
# On (the default, and the only setting fit for a live key): an order is recorded
# as paid only when a VERIFIED row in `payment_intents`, belonging to that
# customer and worth exactly the gateway's share of the order, is there to be
# spent. The `payment.outcome` field in the checkout request is read but not
# believed.
#
# Off: the old behaviour returns and the browser is trusted again. A request
# saying `outcome: "captured"` produces a confirmed order for nothing. It exists
# only so a deployment that hits something unforeseen can be put back inside one
# release without a revert, and GET /ready reports the store unhealthy while it
# is off, so the state cannot be forgotten.
PAYMENT_INTENTS_ENFORCE=true

# --- Media ---
MEDIA_DRIVER=local
MEDIA_ROOT=storage/media
S3_BUCKET=
S3_REGION=
S3_KEY=
S3_SECRET=
S3_ENDPOINT=

# --- Background removal (remove.bg) — the home page hero's ghost cutouts ---
# Get a key at https://www.remove.bg/dashboard#api-key. Blank => uploads still
# save, cutouts report "Skipped", and the console shows why.
REMOVE_BG_API_KEY=
REMOVE_BG_ENDPOINT=https://api.remove.bg/v1.0/removebg
# auto = billed by output size; preview = the free tier's 0.25MP
REMOVE_BG_SIZE=auto
REMOVE_BG_TIMEOUT=45

# --- Mail (SMTP) ---
# Drives the forgotten-password codes on both the shop and the console.
#   log  — writes the whole message, code included, to storage/logs and sends
#          nothing. The development default: the flow is exercisable end to end
#          with no credentials, and `tail -f storage/logs/app-*.log` is the inbox.
#          NEVER production — a code in a log file is a code anyone with the log has.
#   smtp — a real server. SMTP_HOST blank falls back to `log` and logs why.
MAIL_DRIVER=log
MAIL_FROM=no-reply@iced-out.example
MAIL_FROM_NAME=Iced_out
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# tls = STARTTLS on 587 (the usual), ssl = implicit TLS on 465,
# none = a local relay (MailHog/Mailpit) — credentials are refused over `none`.
# Left blank it is inferred from the port: 465 => ssl, anything else => tls.
SMTP_ENCRYPTION=
SMTP_TIMEOUT=15
#
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<the address>,
# and SMTP_PASS=<a 16-character App Password from
# https://myaccount.google.com/apppasswords>, which needs 2-Step Verification on
# the account. The normal account password is refused by Google and always has been.
# MAIL_FROM should be that same address, or the message is rejected or filed as spam.

# --- CORS (split-origin dev only; single-origin prod needs none) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- CSRF trust (spec §5.2) ---
# Which origins may drive a COOKIE-AUTHENTICATED WRITE. Held apart from the CORS
# list because they answer different questions: that one is "who may read a
# response cross-site", this one is "who may spend this shopper's money". They
# used to be the same variable, so widening CORS to fix a preflight during
# development silently widened who was trusted to place orders.
#
# LEAVE IT EMPTY IN PRODUCTION. The site and its API are one origin, so APP_URL
# alone is the whole list and OriginCheck adds it for you. Unset, this falls back
# to CORS_ALLOWED_ORIGINS, which is exactly the old behaviour.
#
# The CRM (crm.<your-domain>) origin must NEVER appear here.
TRUSTED_ORIGINS=

# --- Password pepper ---
# Defaults to SESSION_SECRET, which is what it always effectively was — one
# value doing two jobs. Leaving this blank changes nothing and every existing
# password hash keeps verifying.
#
# Set it ONLY when you need to rotate a leaked SESSION_SECRET. Put the CURRENT
# SESSION_SECRET here first, then mint a new one: sessions all die (which is the
# point) and passwords all survive. Without this step, rotating SESSION_SECRET
# makes every stored password hash unverifiable, permanently.
#
# TWO THINGS USE THIS KEY, and they cost very different amounts to rotate:
#
#   1. The password hashes (PasswordHasher). Rotating forces a password reset on
#      every customer and every staff member. Effectively one-way.
#   2. The password-RESET code hashes (AuthTokenRepository). Rotating invalidates
#      outstanding six-digit codes, which live fifteen minutes. Anyone mid-reset
#      asks for another one. Not worth planning around.
#
# So (1) is what makes this value permanent once set. The two uses are
# domain-separated internally ('pwd:' and 'pwreset:'), so neither can be used as
# an oracle for the other, and there is no reason to want separate variables.
#
# Why the reset codes are keyed at all: the secret in that hash is SIX DIGITS,
# and everything else in it — the audience, the email — is known to an attacker.
# Unkeyed, anyone who could read `auth_tokens` recovered a live reset code by
# trying all one million candidates, which measures at well under a second. The
# key is in this file and not in the database, so reading the database is no
# longer enough. See tests/Smoke/password-reset-smoke.php, which proves both
# halves.
#
# Once set it can never change again without forcing a password reset on every
# customer and every staff member.
PASSWORD_PEPPER=

# --- External delivery-tracking API — PLACEHOLDERS, leave blank until provided (spec §9.8) ---
# Order tracking — iThink Logistics (https://docs.ithinklogistics.com/doc-track-order/3).
# Leave the two credentials blank and the placeholder provider stays bound: the
# shipment screens render, and no courier scan is ever invented.
# Staging host: https://pre-alpha.ithinklogistics.com/api_v3
ITHINK_BASE_URL=https://api.ithinklogistics.com/api_v3
ITHINK_ACCESS_TOKEN=
ITHINK_SECRET_KEY=
ITHINK_TIMEOUT=20
TRACKING_API_WEBHOOK_SECRET=
