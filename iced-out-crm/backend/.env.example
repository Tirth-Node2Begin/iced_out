# Iced_out CRM backend — copy to .env and fill in.
# Every key here is read through Iced\Support\Env; nothing else reads getenv() directly.
#
# ────────────────────────────────────────────────────────────────────────────
# THIS IS THE SECOND HALF OF A TWO-DEPLOYABLE, ONE-DATABASE SPLIT.
#
#   storefront   frontend :3000  →  backend :8000    customer API
#   CRM          frontend :3100  →  backend :8100    console + CRM API
#
# Both backends point at the SAME MySQL database (DB_NAME below). That is the
# whole design: an order taken on the shop is the order the CRM sees, with no
# sync step and nothing to reconcile.
#
# Three keys MUST agree between the two .env files or the split breaks:
#   DB_*             different databases means two shops that never meet
#   SESSION_SECRET   session tokens are HMAC'd with it; a mismatch invalidates
#                    every session the other half issued
#   MEDIA_ROOT       see the note on it below
# ────────────────────────────────────────────────────────────────────────────

APP_ENV=dev
APP_DEBUG=true
# The CRM API's OWN address — this is what makes cookies Secure under https and
# what OriginCheck trusts. Not the storefront's.
APP_URL=http://127.0.0.1:8100
APP_MAINTENANCE=false

# --- Database (MySQL 8.x in production; MariaDB 10.4+ works for local XAMPP dev) ---
# Identical to backend/.env. One database, two apps.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=iced_out
DB_USER=root
DB_PASS=

# --- Redis (optional; absent => file cache + job_queue table fallback) ---
REDIS_URL=

# --- Sessions ---
# The staff cookie is the only one this app issues — there is no customer
# surface here. It must match the storefront's SESSION_COOKIE_STAFF only if you
# ever intend a staff session to be readable by both; with the two apps on
# separate origins it need not, and leaving it distinct is tidier.
SESSION_COOKIE_CUSTOMER=io_csess
SESSION_COOKIE_STAFF=io_ssess
# 64 hex chars — MUST be byte-identical to backend/.env. Generate once, with:
#   php bin/console.php key:generate
SESSION_SECRET=
# Staff sessions are browser-session cookies with a server-side idle TTL.
CUSTOMER_SESSION_TTL=2592000
STAFF_SESSION_IDLE_TTL=900

# --- Payments (Razorpay) ---
# The console reads payment records and can run a gateway check, so the SECRET
# is needed here too. KEY_ID is public; KEY_SECRET never reaches a response.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TIMEOUT=20

# --- Media ---
# ⚠ MUST resolve to the SAME DIRECTORY the storefront backend serves from.
#
# The CRM is where photos are uploaded; the shop is where they are served. Two
# separate storage/media folders means every product photo uploaded in the CRM
# 404s on the storefront — and nothing warns you, because both halves are
# individually correct.
#
# Local dev: point this at the storefront's folder with an absolute path, e.g.
#   MEDIA_ROOT=E:/EB projects/Iced-Out/backend/storage/media
# Production: one shared volume, or MEDIA_DRIVER=s3 with the same bucket.
MEDIA_DRIVER=local
MEDIA_ROOT=
S3_BUCKET=
S3_REGION=
S3_KEY=
S3_SECRET=
S3_ENDPOINT=

# --- Background removal (remove.bg) — the home page hero's ghost cutouts ---
# The hero board lives in the CRM, so the key belongs here rather than on the
# storefront. Blank => uploads still save and every slide reports "Skipped".
REMOVE_BG_API_KEY=
REMOVE_BG_ENDPOINT=https://api.remove.bg/v1.0/removebg
REMOVE_BG_SIZE=auto
REMOVE_BG_TIMEOUT=45

# --- Mail (SMTP) ---
# Drives the forgotten-password codes on both the shop and the console.
#   log  — writes the whole message, code included, to storage/logs and sends
#          nothing. The development default: the flow is exercisable end to end
#          with no credentials, and `tail -f storage/logs/app-*.log` is the inbox.
#          NEVER production — a code in a log file is a code anyone with the log has.
#   smtp — a real server. SMTP_HOST blank falls back to `log` and logs why.
MAIL_DRIVER=log
MAIL_FROM=no-reply@iced-out.example
MAIL_FROM_NAME=Iced_out
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# tls = STARTTLS on 587 (the usual), ssl = implicit TLS on 465,
# none = a local relay (MailHog/Mailpit) — credentials are refused over `none`.
# Left blank it is inferred from the port: 465 => ssl, anything else => tls.
SMTP_ENCRYPTION=
SMTP_TIMEOUT=15
#
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<the address>,
# and SMTP_PASS=<a 16-character App Password from
# https://myaccount.google.com/apppasswords>, which needs 2-Step Verification on
# the account. The normal account password is refused by Google and always has been.
# MAIL_FROM should be that same address, or the message is rejected or filed as spam.

# --- CORS ---
# The CRM frontend proxies /api/v1 through Next (see the frontend's
# next.config.ts), so the browser only ever makes SAME-ORIGIN calls and no
# preflight fires. This list is the escape hatch for a deployment that genuinely
# serves the two on different origins — and if you use it, the staff cookie
# needs SameSite=None; Secure to survive the trip.
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# --- External delivery-tracking API — PLACEHOLDERS, leave blank until provided ---
# Order tracking — iThink Logistics (https://docs.ithinklogistics.com/doc-track-order/3).
# Leave the two credentials blank and the placeholder provider stays bound: the
# shipment screens render, and no courier scan is ever invented.
# Staging host: https://pre-alpha.ithinklogistics.com/api_v3
ITHINK_BASE_URL=https://api.ithinklogistics.com/api_v3
ITHINK_ACCESS_TOKEN=
ITHINK_SECRET_KEY=
ITHINK_TIMEOUT=20
TRACKING_API_WEBHOOK_SECRET=
