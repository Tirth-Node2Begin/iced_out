{
    "name": "iced-out/crm-backend",
    "description": "Iced_out CRM JSON API — console + relationship layer, core PHP, no framework",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Iced\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Iced\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "serve": "php -S 127.0.0.1:8100 -t api dev-server.php",
        "migrate": "php bin/console.php migrate",
        "seed": "php bin/console.php seed",
        "routes": "php bin/console.php routes",
        "stan": "phpstan analyse",
        "test": "phpunit"
    }
}
