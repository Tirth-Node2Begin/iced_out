# The browser never talks to the API's own origin — it calls /api/v1 on whatever
# host the CRM is served from, and `next dev` proxies that to the address below
# (see next.config.ts).
#
# That is what lets the CRM run on localhost:3100 while its API listens on
# 127.0.0.1:8100: those are different *sites* to a browser, and a SameSite=Lax
# staff cookie is never sent across that line. Proxying makes the call
# first-party, so there is no CORS and no lost session.
#
# 8100, not 8000. 8000 is the storefront's API and has no /admin routes on it
# any more — pointing this there gives 404 on every screen.
API_PROXY_ORIGIN=http://127.0.0.1:8100

# Only for a deployment where the API is genuinely on another origin. Leave it
# unset for local development and for the single-origin production layout. If
# you do set it, the staff cookie needs SameSite=None; Secure to survive.
# NEXT_PUBLIC_API_BASE_URL=
